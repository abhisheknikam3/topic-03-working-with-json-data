{
  "name": "N8N JSON Traversal Workflow",
  "nodes": [
    {
      "parameters": {},
      "id": "f1a03001-0001-4000-8000-000000000001",
      "name": "Manual Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        160,
        300
      ]
    },
    {
      "parameters": {
        "mode": "raw",
        "jsonOutput": "={\n  \"receiptId\": \"REC-9988\",\n  \"customer\": {\n    \"firstName\": \"John\",\n    \"lastName\": \"Doe\",\n    \"contact\": {\n      \"email\": \"johndoe@example.com\"\n    }\n  },\n  \"purchasedItems\": [\n    { \"name\": \"Wireless Mouse\", \"price\": 25.99 },\n    { \"name\": \"Mechanical Keyboard\", \"price\": 89.99 }\n  ],\n  \"discountCode\": null\n}",
        "options": {}
      },
      "id": "f1a03001-0002-4000-8000-000000000002",
      "name": "Mock Invoice Data",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        380,
        300
      ]
    },
    {
      "parameters": {
        "mode": "manual",
        "fields": {
          "values": [
            {
              "name": "customerEmail",
              "stringValue": "={{ $json.customer.contact.email }}"
            },
            {
              "name": "fullName",
              "stringValue": "={{ $json.customer.firstName }} {{ $json.customer.lastName }}"
            },
            {
              "name": "firstItemName",
              "stringValue": "={{ $json.purchasedItems[0].name }}"
            },
            {
              "name": "firstItemPrice",
              "type": "number",
              "numberValue": "={{ $json.purchasedItems[0].price }}"
            }
          ]
        },
        "options": {}
      },
      "id": "f1a03001-0003-4000-8000-000000000003",
      "name": "Extract Customer Data",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        600,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://jsonplaceholder.typicode.com/posts",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"title\": \"New Purchase for {{ $json.fullName }}\",\n  \"body\": \"Sent email invoice to {{ $json.customerEmail }}\"\n}",
        "options": {}
      },
      "id": "f1a03001-0004-4000-8000-000000000004",
      "name": "HTTP Request - Post Purchase",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        820,
        300
      ]
    }
  ],
  "connections": {
    "Manual Trigger": {
      "main": [
        [
          {
            "node": "Mock Invoice Data",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Mock Invoice Data": {
      "main": [
        [
          {
            "node": "Extract Customer Data",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Extract Customer Data": {
      "main": [
        [
          {
            "node": "HTTP Request - Post Purchase",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "pinData": {
    "Mock Invoice Data": [
      {
        "json": {
          "receiptId": "REC-9988",
          "customer": {
            "firstName": "John",
            "lastName": "Doe",
            "contact": {
              "email": "johndoe@example.com"
            }
          },
          "purchasedItems": [
            {
              "name": "Wireless Mouse",
              "price": 25.99
            },
            {
              "name": "Mechanical Keyboard",
              "price": 89.99
            }
          ],
          "discountCode": null
        }
      }
    ],
    "Extract Customer Data": [
      {
        "json": {
          "customerEmail": "johndoe@example.com",
          "fullName": "John Doe",
          "firstItemName": "Wireless Mouse",
          "firstItemPrice": 25.99
        }
      }
    ],
    "HTTP Request - Post Purchase": [
      {
        "json": {
          "title": "New Purchase for John Doe",
          "body": "Sent email invoice to johndoe@example.com",
          "id": 101
        }
      }
    ]
  }
}
